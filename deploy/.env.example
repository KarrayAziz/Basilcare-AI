# Copy to deploy/.env (git-ignored) and replace EVERY value before exposing the server.
# docker compose -f deploy/compose.yaml reads deploy/.env automatically.
# Generate random values with:  openssl rand -base64 32

# Public origins WITHOUT trailing slash. TLS_HOSTNAME is the base domain, not a frontend name.
# All names must resolve to the server: add "127.0.0.1 basilcare.test www.basilcare.test admin.basilcare.test api.basilcare.test iam.basilcare.test" to the hosts
# file (/etc/hosts on macOS/Linux, C:\Windows\System32\drivers\etc\hosts on Windows; start.sh offers to).
# If HTTPS_PORT is not 443, include it in ALL origins, e.g. https://www.basilcare.test:8443
PUBLIC_ORIGIN=https://basilcare.test
FARMER_ORIGIN=https://www.basilcare.test
ADMIN_ORIGIN=https://admin.basilcare.test
TLS_HOSTNAME=basilcare.test
HTTPS_PORT=443
HOSTING_ENV=prod

# Password of the WildFly keystore holding the self-signed certificate (created at first start)
TLS_KEYSTORE_PASSWORD=replace-with-a-long-random-string

# Which published WildFly image to run (a release tag such as v1.0.0, or a commit sha-xxxxxxx)
BASILCARE_VERSION=latest

# Node-RED -> API service key (POST /api/ingest/*). Same value is given to both containers.
INGEST_KEY=replace-with-a-long-random-string

# First IAM administrator account "admin" (created at first start only)
ADMIN_PASSWORD=replace-with-a-strong-password

# Node-RED: key that encrypts stored credentials, and the editor login hash
# (make the hash with: docker compose -f deploy/compose.yaml exec nodered node-red admin hash-pw)
NODE_RED_CREDENTIAL_SECRET=replace-with-a-long-random-string
NODE_RED_ADMIN_HASH=

# Optional Gemini provider: passed only to the internal Python assistant, never the frontend.
# Use --mode gemini --env-file ../../../deploy/.env from iot/ai/service.
# Leave empty to disable cloud answers. Never commit your actual key.
GEMINI_API_KEY=

# Shared only between API and internal assistant (24+ random characters). start.sh generates it.
ASSISTANT_SERVICE_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
