# Copy to deploy/.env (git-ignored) and replace EVERY value before exposing the server.
# docker compose -f deploy/compose.yaml reads deploy/.env automatically.
# Generate random values with:  openssl rand -base64 32

# Public origin, WITHOUT trailing slash. Both PWAs, API and IAM are served by WildFly.
# Production example: https://basilcare.example.org (TLS proxy must preserve the paths).
PUBLIC_ORIGIN=http://localhost:8080
HOSTING_ENV=dev

# Node-RED -> API service key (POST /api/ingest/*). Same value is given to both containers.
INGEST_KEY=replace-with-a-long-random-string

# First IAM administrator account "admin" (created at first start only)
ADMIN_PASSWORD=replace-with-a-strong-password

# Node-RED: key that encrypts stored credentials, and the editor login hash
# (make the hash with: docker compose -f deploy/compose.yaml exec nodered node-red admin hash-pw)
NODE_RED_CREDENTIAL_SECRET=replace-with-a-long-random-string
NODE_RED_ADMIN_HASH=
