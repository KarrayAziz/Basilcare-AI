  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// a fresh measurement time for the ingest requests (contract: ISO 8601 with offset)",
          "const now = new Date(); const off = -now.getTimezoneOffset(); const sign = off >= 0 ? '+' : '-';",
          "const pad = (n) => String(Math.abs(n)).padStart(2, '0');",
          "const local = new Date(now.getTime() + off * 60000).toISOString().slice(0, 19);",
          "pm.collectionVariables.set('measuredAt', `${local}${sign}${pad(Math.trunc(off / 60))}:${pad(off % 60)}`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "measuredAt",
      "value": ""
    },
    {
      "key": "incidentId",
      "value": ""
    }
  ],
