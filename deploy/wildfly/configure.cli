# Adapted from the Undertow file-handler/location approach in the professor's
# default-host.cli and add-host.cli. Frontends have separate virtual hosts;
# the backend host also accepts the API and IAM names with their existing contexts.
# Safe to run on every container start: existing resources are updated.
embed-server --server-config=standalone.xml --std-out=echo
set landingPath=`:resolve-expression(expression=${landing.path})`
set farmerPath=`:resolve-expression(expression=${farmer.path})`
set adminPath=`:resolve-expression(expression=${admin.path})`
set domain=`:resolve-expression(expression=${env.TLS_HOSTNAME:basilcare.test})`

# Keep backend contexts for internal Node-RED and JWKS requests.
/subsystem=undertow/server=default-server/host=default-host:write-attribute(name=alias,value=["localhost","$domain","api.$domain","iam.$domain"])

/subsystem=undertow/configuration=handler/file=welcome-content:write-attribute(name=path,value=$landingPath)
/subsystem=undertow/configuration=handler/file=welcome-content:write-attribute(name=directory-listing,value=false)

if (outcome != success) of /subsystem=undertow/configuration=handler/file=farmer-content:read-resource
    /subsystem=undertow/configuration=handler/file=farmer-content:add(path=$farmerPath,directory-listing=false)
else
    /subsystem=undertow/configuration=handler/file=farmer-content:write-attribute(name=path,value=$farmerPath)
end-if
if (outcome != success) of /subsystem=undertow/server=default-server/host=default-host/location=\/farmer:read-resource
    /subsystem=undertow/server=default-server/host=default-host/location=\/farmer:add(handler=farmer-content)
else
    /subsystem=undertow/server=default-server/host=default-host/location=\/farmer:write-attribute(name=handler,value=farmer-content)
end-if

if (outcome != success) of /subsystem=undertow/configuration=handler/file=admin-content:read-resource
    /subsystem=undertow/configuration=handler/file=admin-content:add(path=$adminPath,directory-listing=false)
else
    /subsystem=undertow/configuration=handler/file=admin-content:write-attribute(name=path,value=$adminPath)
end-if
if (outcome != success) of /subsystem=undertow/server=default-server/host=default-host/location=\/admin:read-resource
    /subsystem=undertow/server=default-server/host=default-host/location=\/admin:add(handler=admin-content)
else
    /subsystem=undertow/server=default-server/host=default-host/location=\/admin:write-attribute(name=handler,value=admin-content)
end-if

# Frontends are served at the root of their own hosts.
if (outcome != success) of /subsystem=undertow/server=default-server/host=farmer-host:read-resource
    /subsystem=undertow/server=default-server/host=farmer-host:add(alias=["www.$domain"])
else
    /subsystem=undertow/server=default-server/host=farmer-host:write-attribute(name=alias,value=["www.$domain"])
end-if
if (outcome != success) of /subsystem=undertow/server=default-server/host=farmer-host/location=\/:read-resource
    /subsystem=undertow/server=default-server/host=farmer-host/location=\/:add(handler=farmer-content)
end-if
if (outcome != success) of /subsystem=undertow/server=default-server/host=admin-host:read-resource
    /subsystem=undertow/server=default-server/host=admin-host:add(alias=["admin.$domain"])
else
    /subsystem=undertow/server=default-server/host=admin-host:write-attribute(name=alias,value=["admin.$domain"])
end-if
if (outcome != success) of /subsystem=undertow/server=default-server/host=admin-host/location=\/:read-resource
    /subsystem=undertow/server=default-server/host=admin-host/location=\/:add(handler=admin-content)
end-if

# HTTPS on the https listener (8443) with the keystore start.sh creates or an operator supplies.
# The password stays an expression, resolved by WildFly from the container environment.
set keystorePath=`:resolve-expression(expression=${tls.keystore})`
if (outcome != success) of /subsystem=elytron/key-store=basilcareKS:read-resource
    /subsystem=elytron/key-store=basilcareKS:add(path=$keystorePath,type=PKCS12,credential-reference={clear-text="${env.TLS_KEYSTORE_PASSWORD:changeit}"})
else
    /subsystem=elytron/key-store=basilcareKS:write-attribute(name=path,value=$keystorePath)
end-if
if (outcome != success) of /subsystem=elytron/key-manager=basilcareKM:read-resource
    /subsystem=elytron/key-manager=basilcareKM:add(key-store=basilcareKS,credential-reference={clear-text="${env.TLS_KEYSTORE_PASSWORD:changeit}"})
end-if
if (outcome != success) of /subsystem=elytron/server-ssl-context=basilcareSSC:read-resource
    /subsystem=elytron/server-ssl-context=basilcareSSC:add(key-manager=basilcareKM,protocols=["TLSv1.3","TLSv1.2"])
end-if
/subsystem=undertow/server=default-server/https-listener=https:write-attribute(name=ssl-context,value=basilcareSSC)

stop-embedded-server
